# Database Configuration
DATABASE_URL=postgres://postgres:your_password@localhost:5432/wordwell
TEST_DATABASE_URL=postgres://postgres:your_password@localhost:5432/wordwell_test
DB_SSL=false

# Authentication Secrets
JWT_SECRET=your_very_long_random_jwt_secret_string_here
BCRYPT_SALT_ROUNDS=12

# Frontend Configuration
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_LOGIN_URL=http://localhost:5173/#/login
FRONTEND_URL=http://localhost:5173

# SSO & Cookie Settings
AUTH_COOKIE_DOMAIN=localhost
ALLOW_CROSS_SITE_SSO=false

# Gmail SMTP with OAuth2 credentials (refresh token must allow Gmail sending).
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
GMAIL_USER=yourgmail@gmail.com
EMAIL_FROM=yourgmail@gmail.com

# App Settings
NODE_ENV=development
